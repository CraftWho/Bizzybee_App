# Personal data - never commit real user info to the shared/base template.
# db.js loads this first and falls back to the generic src/core/data.json.
src/core/data.personal.json
src/core/local-save-backups/

# Personal profile photo. profile.html falls back to the local
# avatar-placeholder.svg (a generic camera icon) whenever this file is
# missing, so the shared/base template never ships your actual photo.
src/assets/images/me.jpg

# Real migrated quest/career logs (personal content). The folder structure
# stays tracked; only its file contents are excluded.
src/features/quests/logs/*
!src/features/quests/logs/.gitkeep

# Editor/OS cruft
.vscode/
Thumbs.db
.DS_Store

# Local AI tool config/permissions - machine-specific, not app source.
.claude/

# Private project docs - kept out of git (scrubbed from history 2026-10-08).
# docs/ROADMAP.md and docs/CLOUD_SETUP.md are the shareable versions; the
# private ones now live in workshop/docs/private/ (Oct 2026). Old names kept below. The
# full private ones are *.private.md.
HANDOFF.md
*.private.md
codebase_context_no_images.txt
context2.py
_git_backup_*.tar
EGG_ORIGIN_STORY_SPEC.md
# Design workshop (demos, test pages, art sources, screenshots) - local only.
workshop/
_local_backup_before_history_scrub_2026-08-26/
# Local dependency cache
.npm-cache/
node_modules/

# Local dev login (src/local/admin.local.js) is now committed (Oct 2026) so
# collaborators get the Hacker login on their own machine. It only works on
# localhost / a local network address - app.js never loads it on the live site.

# Your local save files (last 3 saves, full progress + photo) - never commit.
save-files/
# Codebase dump tool output.
repomix-output.xml

# Oct 30 2026 (Craft): local test server (`npm run dev` = netlify dev).
# .netlify/ holds the local sandbox saves and the site link; .env holds local keys.
.netlify/
.env

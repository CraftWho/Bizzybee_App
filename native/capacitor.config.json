{
  "appId": "com.craftwho.bizzybee",
  "appName": "BizzyBee",
  "webDir": "www",
  "android": {
    "backgroundColor": "#050402"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1200,
      "backgroundColor": "#050402",
      "showSpinner": false
    },
    "StatusBar": {
      "backgroundColor": "#050402",
      "style": "DARK",
      "overlaysWebView": false
    },
    "LocalNotifications": {
      "smallIcon": "ic_stat_bee",
      "iconColor": "#FFCC00"
    }
  },
  "server": {
    "androidScheme": "https"
  }
}
